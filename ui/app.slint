import { Palette, ListView, ScrollView } from "std-widgets.slint";

// ============================================================
// 主题：一种强调色（“聆听光”），只用来表示助手正在工作；其余全是中性色。
// scheme：0 跟随系统，1 浅色，2 深色
// ============================================================
export global Theme {
    in-out property <int> scheme: 0;
    out property <bool> dark: scheme == 2 || (scheme == 0 && Palette.color-scheme == ColorScheme.dark);

    // 表面：页面 < 卡片 < 弹出层；输入框比卡片略深（“凹进去”）
    out property <color> canvas: dark ? #0e0f12 : #f4f5f7;
    out property <color> surface: dark ? #16181d : #ffffff;
    out property <color> raised: dark ? #1d2026 : #ffffff;
    out property <color> inset: dark ? #101216 : #eef0f3;
    out property <color> inset-strong: dark ? #282c33 : #e2e5ea;
    out property <color> hairline: dark ? #ffffff14 : #0f172a12;
    out property <color> hairline-strong: dark ? #ffffff26 : #0f172a24;

    // 文字四级：正文 / 次要 / 说明 / 禁用
    out property <color> ink: dark ? #eceef1 : #15171b;
    out property <color> ink-2: dark ? #b6bac2 : #464b55;
    out property <color> ink-3: dark ? #82878f : #7b808a;
    out property <color> ink-4: dark ? #555a62 : #a9aeb6;

    // 聆听光
    out property <color> signal: dark ? #7a84ff : #4b57f0;
    out property <color> signal-hover: dark ? #8d96ff : #3f4ae0;
    out property <color> signal-soft: dark ? #7a84ff29 : #eceefe;
    out property <color> signal-ink: dark ? #c6caff : #2e39c4;
    out property <color> signal-glow: dark ? #7a84ff55 : #4b57f040;

    // 状态色
    out property <color> ok: dark ? #4ade80 : #15803d;
    out property <color> ok-soft: dark ? #4ade8022 : #e8f6ed;
    out property <color> warn: dark ? #fbbf24 : #b45309;
    out property <color> danger: dark ? #f87171 : #dc2626;
}

// 线条图标（24×24，描边）
global Icons {
    out property <string> mic: "M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3z M19 11a7 7 0 0 1-14 0 M12 18v3";
    out property <string> mic-off: "M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3z M19 11a7 7 0 0 1-14 0 M12 18v3 M4 4l16 16";
    out property <string> sliders: "M4 6h10 M18 6h2 M16 4v4 M4 12h3 M11 12h9 M9 10v4 M4 18h12 M20 18h0 M18 16v4";
    out property <string> trash: "M4 7h16 M9 7V4h6v3 M6 7l1 13h10l1-13";
    out property <string> back: "M15 18l-6-6 6-6";
    out property <string> keyboard: "M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1z M7 10h1 M11 10h1 M15 10h2 M8 14h8";
    out property <string> arrow-up: "M12 19V5 M6 11l6-6 6 6";
    out property <string> eye: "M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z M12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6z";
    out property <string> eye-off: "M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z M12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6z M4 4l16 16";
    out property <string> chevron-down: "M6 9l6 6 6-6";
    out property <string> check: "M5 12l5 5 9-10";
    out property <string> bolt: "M13 3L5 13h6l-1 8 8-10h-6l1-8z";
    out property <string> refresh: "M20 11a8 8 0 0 0-14.6-4.5 M4 4v4h4 M4 13a8 8 0 0 0 14.6 4.5 M20 20v-4h-4";
}

component Icon inherits Path {
    in property <string> source;
    in property <color> tint: Theme.ink-2;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.source;
    stroke: root.tint;
    stroke-width: 1.8px;
    fill: transparent;
}

// ============================================================
// 基础控件
// ============================================================

// kind：0 主按钮  1 次按钮  2 文字按钮  3 危险文字按钮
component Btn inherits Rectangle {
    in property <string> text;
    in property <int> kind: 1;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    border-radius: 8px;
    background: !root.enabled ? Theme.inset
        : root.kind == 0 ? (ta.pressed ? Theme.signal-hover : ta.has-hover ? Theme.signal-hover : Theme.signal)
        : root.kind == 1 ? (ta.pressed ? Theme.inset-strong : ta.has-hover ? Theme.inset-strong : Theme.inset)
        : (ta.has-hover ? Theme.inset : transparent);
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: center;
            // 危险操作平时是灰色，悬停才变红，不抢视线
            color: !root.enabled ? Theme.ink-4 : root.kind == 0 ? #ffffff : root.kind == 3 ? (ta.has-hover ? Theme.danger : Theme.ink-3) : Theme.ink;
        }
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> source;
    in property <bool> active;
    in property <length> size: 32px;
    callback clicked;
    width: root.size;
    height: root.size;
    border-radius: 8px;
    background: ta.pressed ? Theme.inset-strong : (ta.has-hover || root.active) ? Theme.inset : transparent;
    animate background { duration: 120ms; }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.source;
        tint: root.active ? Theme.signal : Theme.ink-2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 40px;
    height: 24px;
    border-radius: 12px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.checked ? Theme.signal : Theme.inset-strong;
    animate background { duration: 160ms; }
    Rectangle {
        width: 18px;
        height: 18px;
        y: 3px;
        x: root.checked ? root.width - self.width - 3px : 3px;
        border-radius: 9px;
        background: #ffffff;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000030;
        drop-shadow-offset-y: 1px;
        animate x { duration: 180ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }
    }
    TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> enabled: true;
    in property <length> radius: 8px;
    callback accepted(string);
    callback escaped();
    property <bool> reveal;
    public function focus-input() {
        input.focus();
    }
    height: 36px;
    border-radius: root.radius;
    background: Theme.inset;
    border-width: 1px;
    border-color: input.has-focus ? Theme.signal : ta.has-hover ? Theme.hairline-strong : Theme.hairline;
    opacity: root.enabled ? 1 : 0.5;
    animate border-color { duration: 140ms; }
    ta := TouchArea { mouse-cursor: MouseCursor.text; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: root.password ? 2px : 12px;
        spacing: 2px;
        Rectangle {
            horizontal-stretch: 1;
            // 占位文字放在输入框下面，点击会落到输入框上
            if root.text == "": Text {
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                font-size: 13px;
                color: Theme.ink-4;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> root.text;
                enabled: root.enabled;
                single-line: true;
                font-size: 13px;
                color: Theme.ink;
                vertical-alignment: center;
                selection-background-color: Theme.signal-soft;
                input-type: root.password && !root.reveal ? InputType.password : InputType.text;
                accepted => { root.accepted(self.text); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.escaped();
                        return accept;
                    }
                    reject
                }
            }
        }
        if root.password: VerticalLayout {
            alignment: center;
            IconButton {
                size: 30px;
                source: root.reveal ? Icons.eye-off : Icons.eye;
                clicked => { root.reveal = !root.reveal; }
            }
        }
    }
}

component Stepper inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum;
    in property <int> maximum;
    in property <int> step: 1;
    in property <string> unit;
    in property <bool> enabled: true;
    height: 32px;
    border-radius: 8px;
    background: Theme.inset;
    border-width: 1px;
    border-color: Theme.hairline;
    opacity: root.enabled ? 1 : 0.5;
    HorizontalLayout {
        minus := Rectangle {
            width: 32px;
            border-radius: 7px;
            background: minus-ta.has-hover && root.enabled ? Theme.inset-strong : transparent;
            Text { text: "−"; font-size: 16px; color: Theme.ink-2; horizontal-alignment: center; vertical-alignment: center; }
            minus-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.enabled) {
                        root.value = max(root.minimum, root.value - root.step);
                    }
                }
            }
        }
        Text {
            min-width: 76px;
            text: root.value + " " + root.unit;
            font-size: 13px;
            font-weight: 500;
            color: Theme.ink;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        plus := Rectangle {
            width: 32px;
            border-radius: 7px;
            background: plus-ta.has-hover && root.enabled ? Theme.inset-strong : transparent;
            Text { text: "+"; font-size: 16px; color: Theme.ink-2; horizontal-alignment: center; vertical-alignment: center; }
            plus-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.enabled) {
                        root.value = min(root.maximum, root.value + root.step);
                    }
                }
            }
        }
    }
}

component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    in property <bool> enabled: true;
    callback changed(int);
    height: 32px;
    border-radius: 8px;
    background: Theme.inset;
    opacity: root.enabled ? 1 : 0.5;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for option[i] in root.options: Rectangle {
            min-width: 52px;
            horizontal-stretch: 1;
            border-radius: 6px;
            background: i == root.current ? Theme.raised : seg-ta.has-hover ? Theme.inset-strong : transparent;
            drop-shadow-blur: i == root.current && !Theme.dark ? 3px : 0px;
            drop-shadow-color: #0f172a1f;
            drop-shadow-offset-y: 1px;
            animate background { duration: 120ms; }
            Text {
                width: parent.width;
                height: parent.height;
                text: option;
                font-size: 12px;
                font-weight: i == root.current ? 600 : 400;
                color: i == root.current ? Theme.ink : Theme.ink-3;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            seg-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if (root.enabled) {
                        root.current = i;
                        root.changed(i);
                    }
                }
            }
        }
    }
}

component Select inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    height: 36px;
    border-radius: 8px;
    background: Theme.inset;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.hairline-strong : Theme.hairline;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            horizontal-stretch: 1;
            text: root.current >= 0 && root.current < root.options.length ? root.options[root.current] : "";
            font-size: 13px;
            color: Theme.ink;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Icon { width: 16px; height: 16px; source: Icons.chevron-down; tint: Theme.ink-3; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            background: Theme.raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.hairline-strong;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0f172a26;
            drop-shadow-offset-y: 4px;
            VerticalLayout {
                padding: 4px;
                for option[i] in root.options: Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: item-ta.has-hover ? Theme.inset : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            horizontal-stretch: 1;
                            text: option;
                            font-size: 13px;
                            font-weight: i == root.current ? 600 : 400;
                            color: Theme.ink;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        VerticalLayout {
                            alignment: center;
                            Icon { width: 16px; height: 16px; source: Icons.check; tint: i == root.current ? Theme.signal : transparent; }
                        }
                    }
                    item-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current = i;
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

component RangeSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    in property <bool> enabled: true;
    property <float> ratio: max(0, min(1, (root.value - root.minimum) / (root.maximum - root.minimum)));
    height: 24px;
    opacity: root.enabled ? 1 : 0.5;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.inset-strong;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: (root.width - 16px) * root.ratio + 8px;
        height: 4px;
        border-radius: 2px;
        background: Theme.signal;
    }
    Rectangle {
        x: (root.width - self.width) * root.ratio;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        border-width: 1px;
        border-color: Theme.hairline-strong;
        drop-shadow-blur: 4px;
        drop-shadow-color: #0f172a33;
        drop-shadow-offset-y: 1px;
    }
    function set-from(x: length) {
        if (root.enabled) {
            root.value = root.minimum + max(0, min(1, (x - 8px) / (root.width - 16px))) * (root.maximum - root.minimum);
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
}

// 状态徽标：0 未设置  1 已就绪  2 测试中  3 测试通过  4 测试失败
component KeyBadge inherits Rectangle {
    in property <int> state;
    property <color> tone: root.state == 0 ? Theme.warn : root.state == 2 ? Theme.signal : root.state == 4 ? Theme.danger : Theme.ok;
    height: 22px;
    horizontal-stretch: 0;
    border-radius: 11px;
    background: root.state == 1 || root.state == 3 ? Theme.ok-soft : Theme.inset;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.tone; }
        }
        Text {
            text: root.state == 0 ? "未设置" : root.state == 1 ? "已设置" : root.state == 2 ? "测试中…" : root.state == 3 ? "测试通过" : "测试失败";
            font-size: 11px;
            font-weight: 500;
            color: root.tone;
            vertical-alignment: center;
        }
    }
}

// ============================================================
// 设置页的结构件
// ============================================================

component SectionLabel inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Theme.ink-3;
}

component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.hairline;
    drop-shadow-blur: Theme.dark ? 0px : 6px;
    drop-shadow-color: #0f172a0f;
    drop-shadow-offset-y: 1px;
    VerticalLayout {
        @children
    }
}

component Divider inherits HorizontalLayout {
    padding-left: 16px;
    Rectangle { height: 1px; background: Theme.hairline; }
}

// 左边标题 + 说明，右边放控件
component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 16px;
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            font-size: 13px;
            font-weight: 500;
            color: Theme.ink;
        }
        if root.description != "": Text {
            text: root.description;
            font-size: 11px;
            color: Theme.ink-3;
            wrap: word-wrap;
        }
    }
    @children
}

// 标题在上，控件占满一行
component FieldBlock inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 6px;
    Text {
        text: root.title;
        font-size: 13px;
        font-weight: 500;
        color: Theme.ink;
    }
    @children
    if root.hint != "": Text {
        text: root.hint;
        font-size: 11px;
        color: Theme.ink-3;
        wrap: word-wrap;
    }
}

component KeyBlock inherits VerticalLayout {
    in property <int> state;
    in property <string> detail;
    in property <string> hint;
    in property <string> placeholder;
    in property <bool> saved;
    in-out property <string> input;
    callback test();
    callback clear();
    // 清除不可撤销：第一次点只是询问，3 秒内再点才真正清除
    property <bool> confirm-clear;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 14px;
    padding-bottom: 14px;
    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: "API Key";
            font-size: 13px;
            font-weight: 500;
            color: Theme.ink;
            vertical-alignment: center;
        }
        KeyBadge { state: root.state; }
        Rectangle { horizontal-stretch: 1; }
    }
    TextField {
        password: true;
        placeholder: root.placeholder;
        text <=> root.input;
    }
    HorizontalLayout {
        spacing: 8px;
        Btn {
            text: "测试";
            enabled: root.state != 2;
            clicked => { root.test(); }
        }
        if root.saved: Btn {
            text: root.confirm-clear ? "再点一次确认清除" : "清除已保存的 key";
            kind: 3;
            clicked => {
                if (root.confirm-clear) {
                    root.confirm-clear = false;
                    root.clear();
                } else {
                    root.confirm-clear = true;
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    Timer {
        interval: 3s;
        running: root.confirm-clear;
        triggered => { root.confirm-clear = false; }
    }
    if root.detail != "": Text {
        text: root.detail;
        font-size: 11px;
        color: root.state == 4 ? Theme.danger : root.state == 3 ? Theme.ok : Theme.ink-3;
        wrap: word-wrap;
    }
    Text {
        text: root.hint;
        font-size: 11px;
        color: Theme.ink-4;
        wrap: word-wrap;
    }
}

// ============================================================
// 对话页
// ============================================================

export struct ChatItem {
    // 0 用户  1 助手  2 工具调用  3 系统提示
    role: int,
    text: string,
}

component MessageRow inherits HorizontalLayout {
    in property <ChatItem> item;
    in property <length> max-bubble;
    property <int> role: root.item.role;
    padding-left: root.role == 0 ? 64px : 20px;
    padding-right: root.role == 0 ? 20px : 40px;
    padding-top: root.role >= 2 ? 2px : 8px;
    padding-bottom: root.role >= 2 ? 2px : 8px;
    spacing: 10px;
    alignment: root.role == 0 ? end : root.role == 3 ? center : start;

    // 助手的回答：不用气泡，左边一个小光点
    if root.role == 1: VerticalLayout {
        alignment: start;
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: Theme.signal-soft;
            Rectangle {
                x: 7px;
                y: 7px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.signal;
            }
        }
    }
    // 工具调用缩进到和助手正文对齐
    if root.role == 2: Rectangle { width: 22px; }

    Rectangle {
        max-width: root.role == 1 ? root.max-bubble + 32px : root.max-bubble;
        background: root.role == 0 ? Theme.signal-soft : root.role == 2 ? Theme.inset : transparent;
        border-radius: root.role == 0 ? 16px : 6px;
        border-bottom-right-radius: root.role == 0 ? 6px : 6px;
        HorizontalLayout {
            padding-left: root.role == 0 ? 14px : root.role == 2 ? 8px : 0px;
            padding-right: root.role == 0 ? 14px : root.role == 2 ? 10px : 0px;
            padding-top: root.role == 0 ? 9px : root.role == 2 ? 4px : 2px;
            padding-bottom: root.role == 0 ? 9px : root.role == 2 ? 4px : 2px;
            spacing: 6px;
            if root.role == 2: VerticalLayout {
                alignment: center;
                Icon { width: 12px; height: 12px; source: Icons.bolt; tint: Theme.ink-3; stroke-width: 1.6px; }
            }
            Text {
                text: root.item.text;
                wrap: root.role == 2 ? no-wrap : word-wrap;
                overflow: elide;
                font-size: root.role >= 2 ? 11px : 13px;
                color: root.role == 0 ? Theme.signal-ink : root.role == 1 ? Theme.ink : Theme.ink-3;
                horizontal-alignment: root.role == 3 ? center : left;
            }
        }
    }
}

component SuggestionChip inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 34px;
    border-radius: 17px;
    background: ta.has-hover ? Theme.surface : transparent;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.hairline-strong : Theme.hairline;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            font-size: 12px;
            color: Theme.ink-2;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 聆听光球：整个界面的主角，也是麦克风按钮。
// mode：0 待机  1 正在听  2 思考  3 执行  4 播报  5 已暂停
component Orb inherits Rectangle {
    in property <int> mode;
    callback clicked;
    property <bool> active: root.mode >= 1 && root.mode <= 4;
    // 只有工作时才逐帧刷新，待机时不占 CPU
    property <float> t: root.active ? animation-tick() / 1ms : 0;
    property <length> core-size: ta.pressed ? 60px : 64px;
    width: 132px;
    height: 104px;

    // 正在听：两圈向外扩散的波纹
    for i in 2: Rectangle {
        property <float> phase: mod(root.t / 1700 + i * 0.5, 1.0);
        width: 64px * (1 + self.phase * 0.62);
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: Theme.signal;
        opacity: root.mode == 1 ? (1 - self.phase) * 0.55 : 0;
    }
    // 待机：一圈很淡的静态光晕（音箱光环的意象）
    Rectangle {
        width: 64px + 18px;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Theme.signal-soft;
        opacity: root.mode == 0 ? 0.8 : 0;
        animate opacity { duration: 200ms; }
    }
    // 播报：外圈随节奏呼吸
    Rectangle {
        property <float> pulse: (sin(root.t / 900 * 360deg) + 1) / 2;
        width: 64px + 14px + self.pulse * 10px;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Theme.signal-soft;
        opacity: root.mode == 4 ? 1 : 0;
    }
    core := Rectangle {
        width: root.core-size;
        height: self.width;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.mode == 0 ? (ta.has-hover ? Theme.raised : Theme.surface)
            : root.mode == 5 ? Theme.inset
            : root.mode == 2 || root.mode == 3 ? Theme.signal-hover
            : Theme.signal;
        border-width: root.mode == 0 || root.mode == 5 ? 1px : 0px;
        border-color: ta.has-hover ? Theme.signal : Theme.hairline-strong;
        drop-shadow-blur: root.active ? 24px : 10px;
        drop-shadow-color: root.active ? Theme.signal-glow : #0f172a1a;
        drop-shadow-offset-y: root.active ? 0px : 2px;
        animate background, border-color { duration: 180ms; }
        animate width { duration: 120ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }

        // 思考 / 执行：三个点依次亮起
        if root.mode == 2 || root.mode == 3: HorizontalLayout {
            alignment: center;
            spacing: 6px;
            for i in 3: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: #ffffff;
                    opacity: 0.35 + 0.65 * max(0, sin((root.t / 1000 - i * 0.18) * 360deg));
                }
            }
        }
        if root.mode != 2 && root.mode != 3: Icon {
            width: 26px;
            height: 26px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            stroke-width: 2px;
            source: root.mode == 5 ? Icons.mic-off : Icons.mic;
            tint: root.mode == 0 ? Theme.signal : root.mode == 5 ? Theme.ink-3 : #ffffff;
        }
    }
    ta := TouchArea {
        x: core.x - 6px;
        y: core.y - 6px;
        width: 76px;
        height: 76px;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ============================================================
// 主窗口
// ============================================================

export component AppWindow inherits Window {
    title: "VOA";
    icon: root.app-icon;
    background: Theme.canvas;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 13px;
    preferred-width: 460px;
    preferred-height: 760px;
    min-width: 380px;
    min-height: 560px;

    in property <image> app-icon;
    // 状态
    in property <int> status-code;
    in property <string> partial;
    in property <string> memory;
    in property <string> mic-name;
    in property <[ChatItem]> messages;
    in-out property <bool> listening-enabled: true;

    // 设置：大模型
    in-out property <string> llm-key-input;
    in property <string> llm-key-status;
    in property <int> llm-key-state;
    in property <bool> llm-key-saved;
    in-out property <string> llm-base-url;
    in-out property <string> llm-model;
    in-out property <bool> llm-thinking;
    in-out property <int> effort-index;
    in-out property <int> new-conversation-secs;
    // 设置：语音识别
    in-out property <string> asr-key-input;
    in property <string> asr-key-status;
    in property <int> asr-key-state;
    in property <bool> asr-key-saved;
    in-out property <string> asr-url;
    in-out property <string> asr-model;
    in-out property <int> asr-silence-ms;
    in-out property <int> asr-timeout-secs;
    // 设置：唤醒与麦克风
    in-out property <string> wake-words;
    // 已保存的第一个唤醒词，空状态的提示用
    in property <string> first-wake-word: "你好电脑";
    in-out property <float> sensitivity: 0.6;
    in-out property <float> kws-score: 1.5;
    in-out property <bool> follow-up;
    in-out property <bool> listen-on-start;
    in property <[string]> devices;
    in-out property <int> device-index;
    // 设置：操控、播报、启动
    in-out property <bool> desktop-control;
    in-out property <bool> browser-control;
    in-out property <int> browser-idle-minutes;
    in-out property <string> playwright-package;
    in-out property <float> tts-rate;
    in-out property <bool> show-on-start;
    in-out property <bool> float-ball;
    in-out property <bool> launch-at-login;
    in-out property <string> settings-note;
    // 0 成功  1 出错  2 普通说明
    in property <int> note-kind;
    in property <bool> settings-dirty;
    // 后台智能体与语音对话
    in-out property <int> executor-index;
    in-out property <int> access-index;
    in-out property <string> agent-workdir;
    in-out property <string> agent-model;
    in-out property <string> executor-status;
    in-out property <int> frontend-index;
    in-out property <string> realtime-model;
    in-out property <string> realtime-voice;
    in-out property <bool> barge-in;
    in-out property <bool> full-duplex;

    callback send-text(string);
    callback talk();
    callback toggle-listening(bool);
    callback clear-chat();
    callback save-settings();
    callback reset-settings();
    callback refresh-devices();
    callback test-llm();
    callback test-asr();
    callback clear-llm-key();
    callback clear-asr-key();
    callback theme-changed();
    callback discard-settings();

    // 0 对话  1 设置
    in-out property <int> page: 0;
    // 有未保存的更改时点了返回：底栏改成询问保存还是放弃
    property <bool> leave-pending;
    property <bool> show-keyboard: false;
    property <string> draft;

    public function scroll-to-bottom() {
        chat-list.content-y = min(0px, chat-list.visible-height - chat-list.content-height);
    }

    function leave-settings() {
        if (root.settings-dirty) {
            root.leave-pending = true;
        } else {
            root.settings-note = "";
            root.page = 0;
        }
    }

    function submit() {
        if (root.draft != "") {
            root.send-text(root.draft);
            root.draft = "";
        }
    }

    property <string> orb-caption: root.status-code == 1 ? "正在听…"
        : root.status-code == 2 ? "思考中…"
        : root.status-code == 3 ? "正在操作…"
        : root.status-code == 4 ? "正在回答…"
        : root.status-code == 5 ? "语音唤醒已暂停，点按说话"
        : "点按说话";

    // -------------------- 对话页 --------------------
    Rectangle {
    width: root.width;
    height: root.height;
    visible: root.page == 0;
    VerticalLayout {
        width: parent.width;
        height: parent.height;
        // 顶栏
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 20px;
            padding-right: 12px;
            padding-top: 14px;
            padding-bottom: 10px;
            spacing: 4px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: "VOA";
                    font-size: 17px;
                    font-weight: 600;
                    letter-spacing: -0.2px;
                    color: Theme.ink;
                }
                Text {
                    text: root.mic-name == "" ? "正在准备麦克风…" : root.mic-name;
                    font-size: 11px;
                    color: Theme.ink-3;
                    overflow: elide;
                }
            }
            if root.messages.length > 0: VerticalLayout {
                alignment: center;
                IconButton {
                    source: Icons.trash;
                    clicked => { root.clear-chat(); }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    source: Icons.sliders;
                    clicked => { root.page = 1; }
                }
            }
        }

        // 消息区
        Rectangle {
            vertical-stretch: 1;
            chat-list := ListView {
                width: parent.width;
                height: parent.height;
                visible: root.messages.length > 0;
                for item in root.messages: MessageRow {
                    item: item;
                    max-bubble: chat-list.visible-width * 0.72;
                }
            }
            // 空状态
            if root.messages.length == 0: VerticalLayout {
                width: parent.width;
                height: parent.height;
                alignment: center;
                spacing: 18px;
                padding-left: 32px;
                padding-right: 32px;
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "有什么可以帮你？";
                        font-size: 22px;
                        font-weight: 600;
                        letter-spacing: -0.3px;
                        color: Theme.ink;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: !root.listening-enabled ? "语音唤醒已暂停，点下方的光球直接说话"
                            : "说“" + root.first-wake-word + "”唤醒我，或者点下方的光球";
                        font-size: 13px;
                        color: Theme.ink-3;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
                // 还没填百炼的 key：语音对话用不了，先引导去设置
                if root.asr-key-state == 0: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        max-width: 360px;
                        background: Theme.surface;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.hairline;
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 3px;
                                Text {
                                    text: "还差一步：填写 API Key";
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.ink;
                                }
                                Text {
                                    text: "语音对话需要阿里云百炼的 key；现在也可以先打字使用";
                                    font-size: 11px;
                                    color: Theme.ink-3;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Btn {
                                    text: "去设置";
                                    kind: 0;
                                    clicked => { root.page = 1; }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    SuggestionChip {
                        text: "现在几点了";
                        clicked => { root.send-text(self.text); }
                    }
                    SuggestionChip {
                        text: "打开计算器";
                        clicked => { root.send-text(self.text); }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    SuggestionChip {
                        text: "搜索明天的天气";
                        clicked => { root.send-text(self.text); }
                    }
                    SuggestionChip {
                        text: "在 B 站搜索 Python 教程";
                        clicked => { root.send-text(self.text); }
                    }
                }
            }
        }

        // 边说边出字
        if root.partial != "": HorizontalLayout {
            padding-left: 64px;
            padding-right: 20px;
            padding-bottom: 4px;
            alignment: end;
            Rectangle {
                background: Theme.signal-soft;
                border-radius: 16px;
                border-bottom-right-radius: 6px;
                border-width: 1px;
                border-color: Theme.signal;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 9px;
                    padding-bottom: 9px;
                    Text {
                        text: root.partial;
                        wrap: word-wrap;
                        font-size: 13px;
                        color: Theme.signal-ink;
                    }
                }
            }
        }

        // 键盘输入（可选）
        if root.show-keyboard: HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 6px;
            spacing: 8px;
            TextField {
                height: 40px;
                radius: 20px;
                placeholder: "输入命令，回车发送，Esc 收起";
                text <=> root.draft;
                init => { self.focus-input(); }
                accepted => { root.submit(); }
                escaped => { root.show-keyboard = false; }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: root.draft == "" ? Theme.inset-strong : send-ta.has-hover ? Theme.signal-hover : Theme.signal;
                    animate background { duration: 120ms; }
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: Icons.arrow-up;
                        tint: root.draft == "" ? Theme.ink-4 : #ffffff;
                        stroke-width: 2.2px;
                    }
                    send-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.submit(); }
                    }
                }
            }
        }

        // 底部：唤醒开关 · 光球 · 键盘
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 4px;
            padding-bottom: 14px;
            VerticalLayout {
                width: 88px;
                alignment: center;
                spacing: 6px;
                HorizontalLayout {
                    alignment: center;
                    Toggle {
                        checked <=> root.listening-enabled;
                        toggled(on) => { root.toggle-listening(on); }
                    }
                }
                Text {
                    text: "语音唤醒";
                    font-size: 11px;
                    color: Theme.ink-3;
                    horizontal-alignment: center;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Orb {
                    mode: root.status-code;
                    clicked => { root.talk(); }
                }
                Text {
                    text: root.orb-caption;
                    font-size: 12px;
                    font-weight: root.status-code >= 1 && root.status-code <= 4 ? 600 : 400;
                    color: root.status-code >= 1 && root.status-code <= 4 ? Theme.signal-ink : Theme.ink-3;
                    horizontal-alignment: center;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                width: 88px;
                alignment: center;
                spacing: 4px;
                HorizontalLayout {
                    alignment: center;
                    IconButton {
                        size: 36px;
                        source: Icons.keyboard;
                        active: root.show-keyboard;
                        clicked => { root.show-keyboard = !root.show-keyboard; }
                    }
                }
                Text {
                    text: "打字";
                    font-size: 11px;
                    color: Theme.ink-3;
                    horizontal-alignment: center;
                }
            }
        }
    }
    }

    // -------------------- 设置页 --------------------
    Rectangle {
    width: root.width;
    height: root.height;
    visible: root.page == 1;
    VerticalLayout {
        width: parent.width;
        height: parent.height;
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 12px;
            padding-right: 20px;
            padding-top: 12px;
            padding-bottom: 8px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                IconButton {
                    source: Icons.back;
                    clicked => { root.leave-settings(); }
                }
            }
            Text {
                text: "设置";
                font-size: 17px;
                font-weight: 600;
                letter-spacing: -0.2px;
                color: Theme.ink;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 4px;
                padding-bottom: 16px;
                spacing: 8px;

                SectionLabel { text: "后台智能体"; }
                Card {
                    FieldBlock {
                        title: "谁来干活";
                        hint: root.executor-status;
                        Select {
                            options: ["Codex", "Claude Code", "内置助手（DeepSeek）"];
                            current <=> root.executor-index;
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "权限";
                        description: root.access-index == 0 ? "什么都能做，不再逐项确认；听错一句话也可能被执行" : root.access-index == 1 ? "只能改工作目录里的文件，桌面操作走自带工具" : "只能查看和回答，不能修改任何东西";
                        VerticalLayout {
                            alignment: center;
                            Segmented {
                                width: 196px;
                                options: ["完全访问", "工作目录", "只读"];
                                current <=> root.access-index;
                            }
                        }
                    }
                    Divider { }
                    FieldBlock {
                        title: "工作目录";
                        hint: "留空使用用户目录。";
                        TextField { text <=> root.agent-workdir; placeholder: "例如 D:\\code"; }
                    }
                    Divider { }
                    FieldBlock {
                        title: "模型";
                        hint: "留空使用智能体自己的默认模型。";
                        TextField { text <=> root.agent-model; }
                    }
                }

                SectionLabel { text: "语音对话"; }
                Card {
                    SettingRow {
                        title: "对话方式";
                        description: root.frontend-index == 0 ? "百炼实时语音模型：边说边回，更自然" : "语音识别 + DeepSeek + 系统播报";
                        VerticalLayout {
                            alignment: center;
                            Segmented {
                                width: 196px;
                                options: ["实时语音", "识别+大模型"];
                                current <=> root.frontend-index;
                            }
                        }
                    }
                    Divider { }
                    FieldBlock {
                        title: "实时语音模型";
                        hint: "使用下方“语音识别”里填写的阿里云百炼 key。qwen-audio-3.1-realtime-flash 更便宜。";
                        TextField { text <=> root.realtime-model; }
                    }
                    Divider { }
                    FieldBlock {
                        title: "音色";
                        TextField { text <=> root.realtime-voice; }
                    }
                    Divider { }
                    SettingRow {
                        title: "说唤醒词打断播报";
                        description: "助手说话时喊一声唤醒词，它就停下来听你说";
                        VerticalLayout {
                            alignment: center;
                            Toggle { checked <=> root.barge-in; }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "戴耳机，直接插话";
                        description: "播报时麦克风也开着，直接说话就能打断；外放时请关闭";
                        VerticalLayout {
                            alignment: center;
                            Toggle { checked <=> root.full-duplex; }
                        }
                    }
                }

                SectionLabel { text: "大模型 · DeepSeek"; }
                Card {
                    KeyBlock {
                        state: root.llm-key-state;
                        detail: root.llm-key-status;
                        placeholder: "粘贴新的 key（留空表示不修改）";
                        hint: "在 platform.deepseek.com 的 API keys 页面创建。key 用 Windows 加密保存在本机，界面上不再显示。";
                        saved: root.llm-key-saved;
                        input <=> root.llm-key-input;
                        test => { root.test-llm(); }
                        clear => { root.clear-llm-key(); }
                    }
                    Divider { }
                    FieldBlock {
                        title: "接口地址";
                        TextField { text <=> root.llm-base-url; }
                    }
                    Divider { }
                    FieldBlock {
                        title: "模型";
                        hint: "deepseek-flash 快且便宜；deepseek-v4-pro 更强。";
                        TextField { text <=> root.llm-model; }
                    }
                    Divider { }
                    SettingRow {
                        title: "深度思考";
                        description: "多步操作更稳，简单命令几乎不变慢";
                        VerticalLayout {
                            alignment: center;
                            Toggle { checked <=> root.llm-thinking; }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "思考强度";
                        VerticalLayout {
                            alignment: center;
                            Segmented {
                                width: 168px;
                                enabled: root.llm-thinking;
                                options: ["低", "高", "最高"];
                                current <=> root.effort-index;
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "新对话间隔";
                        description: "这么久没说话后，忘掉之前的上下文";
                        VerticalLayout {
                            alignment: center;
                            Stepper {
                                minimum: 30;
                                maximum: 3600;
                                step: 30;
                                unit: "秒";
                                value <=> root.new-conversation-secs;
                            }
                        }
                    }
                }

                SectionLabel { text: "语音识别 · 阿里云百炼"; }
                Card {
                    KeyBlock {
                        state: root.asr-key-state;
                        detail: root.asr-key-status;
                        placeholder: "粘贴新的 key（留空表示不修改）";
                        hint: "在 bailian.console.aliyun.com 的 API-KEY 页面创建。约 1.2 元/小时，只在唤醒后上传音频。";
                        saved: root.asr-key-saved;
                        input <=> root.asr-key-input;
                        test => { root.test-asr(); }
                        clear => { root.clear-asr-key(); }
                    }
                    Divider { }
                    FieldBlock {
                        title: "服务地址";
                        TextField { text <=> root.asr-url; }
                    }
                    Divider { }
                    FieldBlock {
                        title: "模型";
                        TextField { text <=> root.asr-model; }
                    }
                    Divider { }
                    SettingRow {
                        title: "断句静音";
                        description: "停顿多久算说完一句";
                        VerticalLayout {
                            alignment: center;
                            Stepper {
                                minimum: 200;
                                maximum: 6000;
                                step: 100;
                                unit: "毫秒";
                                value <=> root.asr-silence-ms;
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "等待开口";
                        description: "唤醒后这么久没说话就放弃";
                        VerticalLayout {
                            alignment: center;
                            Stepper {
                                minimum: 2;
                                maximum: 30;
                                unit: "秒";
                                value <=> root.asr-timeout-secs;
                            }
                        }
                    }
                }

                SectionLabel { text: "唤醒与麦克风"; }
                Card {
                    FieldBlock {
                        title: "唤醒词";
                        hint: "中文，多个用逗号分隔；四个字的词最不容易误唤醒。";
                        TextField { text <=> root.wake-words; }
                    }
                    Divider { }
                    SettingRow {
                        title: "灵敏度";
                        description: "越高越容易唤醒，也越容易误唤醒";
                        HorizontalLayout {
                            spacing: 10px;
                            RangeSlider {
                                width: 120px;
                                value <=> root.sensitivity;
                            }
                            Text {
                                width: 34px;
                                text: round(root.sensitivity * 100) + "%";
                                font-size: 12px;
                                color: Theme.ink-2;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "唤醒词加权";
                        description: "嘈杂环境建议调低";
                        HorizontalLayout {
                            spacing: 10px;
                            RangeSlider {
                                width: 120px;
                                minimum: 0.5;
                                maximum: 3;
                                value <=> root.kws-score;
                            }
                            Text {
                                width: 34px;
                                text: round(root.kws-score * 10) / 10;
                                font-size: 12px;
                                color: Theme.ink-2;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Divider { }
                    FieldBlock {
                        title: "麦克风";
                        HorizontalLayout {
                            spacing: 8px;
                            Select {
                                horizontal-stretch: 1;
                                options: root.devices;
                                current <=> root.device-index;
                            }
                            IconButton {
                                size: 36px;
                                source: Icons.refresh;
                                clicked => { root.refresh-devices(); }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "启动时开启语音唤醒";
                        VerticalLayout {
                            alignment: center;
                            Toggle { checked <=> root.listen-on-start; }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "回复后继续聆听";
                        description: "接着说话不用再喊唤醒词";
                        VerticalLayout {
                            alignment: center;
                            Toggle { checked <=> root.follow-up; }
                        }
                    }
                }

                SectionLabel { text: "操控权限"; }
                Card {
                    SettingRow {
                        title: "控制桌面软件";
                        description: "读取窗口控件、点击、输入、快捷键";
                        VerticalLayout {
                            alignment: center;
                            Toggle { checked <=> root.desktop-control; }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "控制浏览器";
                        description: "按需启动独立的 Edge 窗口，需要 Node.js";
                        VerticalLayout {
                            alignment: center;
                            Toggle { checked <=> root.browser-control; }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "浏览器闲置关闭";
                        VerticalLayout {
                            alignment: center;
                            Stepper {
                                enabled: root.browser-control;
                                minimum: 1;
                                maximum: 120;
                                unit: "分钟";
                                value <=> root.browser-idle-minutes;
                            }
                        }
                    }
                    Divider { }
                    FieldBlock {
                        title: "Playwright 包";
                        TextField {
                            enabled: root.browser-control;
                            text <=> root.playwright-package;
                        }
                    }
                }

                SectionLabel { text: "外观、播报与启动"; }
                Card {
                    SettingRow {
                        title: "外观";
                        VerticalLayout {
                            alignment: center;
                            Segmented {
                                width: 168px;
                                options: ["跟随系统", "浅色", "深色"];
                                current <=> Theme.scheme;
                                changed => { root.theme-changed(); }
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "语速";
                        HorizontalLayout {
                            spacing: 10px;
                            RangeSlider {
                                width: 120px;
                                minimum: -5;
                                maximum: 5;
                                value <=> root.tts-rate;
                            }
                            Text {
                                width: 34px;
                                text: round(root.tts-rate);
                                font-size: 12px;
                                color: Theme.ink-2;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "显示悬浮球";
                        description: "桌面上的小光球，单击展开主界面，可以拖到任意位置";
                        VerticalLayout {
                            alignment: center;
                            Toggle { checked <=> root.float-ball; }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "开机自动启动";
                        description: "登录 Windows 后自动在后台运行";
                        VerticalLayout {
                            alignment: center;
                            Toggle { checked <=> root.launch-at-login; }
                        }
                    }
                    Divider { }
                    SettingRow {
                        title: "启动时打开主界面";
                        description: "关闭时只显示悬浮球；开机自启时始终不打开";
                        VerticalLayout {
                            alignment: center;
                            Toggle { checked <=> root.show-on-start; }
                        }
                    }
                }

                VerticalLayout {
                    padding-top: 4px;
                    spacing: 2px;
                    HorizontalLayout {
                        alignment: center;
                        Btn {
                            text: "恢复默认设置";
                            kind: 2;
                            clicked => { root.reset-settings(); }
                        }
                    }
                    if root.memory != "": Text {
                        text: "当前" + root.memory;
                        font-size: 11px;
                        color: Theme.ink-4;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // 固定在底部的操作栏
        Rectangle {
            height: 1px;
            background: Theme.hairline;
        }
        HorizontalLayout {
            vertical-stretch: 0;
            padding-left: 20px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 10px;
            Text {
                horizontal-stretch: 1;
                text: root.leave-pending ? "更改还没有保存"
                    : root.settings-note != "" ? root.settings-note
                    : root.settings-dirty ? "有未保存的更改" : "";
                font-size: 12px;
                color: root.leave-pending || (root.settings-note == "" && root.settings-dirty) ? Theme.warn
                    : root.note-kind == 1 ? Theme.danger
                    : root.note-kind == 0 ? Theme.ok : Theme.ink-3;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            if root.leave-pending: Btn {
                text: "放弃更改";
                kind: 2;
                clicked => {
                    root.discard-settings();
                    root.leave-pending = false;
                    root.page = 0;
                }
            }
            Btn {
                text: "保存并应用";
                kind: 0;
                clicked => {
                    root.save-settings();
                    // 保存失败（比如校验没通过）时留在设置页，让人看到原因
                    if (root.leave-pending && !root.settings-dirty) {
                        root.settings-note = "";
                        root.page = 0;
                    }
                    root.leave-pending = false;
                }
            }
        }
    }
    }
}
